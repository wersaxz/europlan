create temp table "fin" as 
select distinct
f."инн_контрагента"::text,
f."фамилия",
f."имя",
f."отчество",
f."CtaRepositoryId",
--f."инн_физ_лица_norm" as "инн_физ_лица" ,
f."должность",
--f."дата_рождения",
f."Источник банк",
f."number_telephone",
f."project_flag_ul",
--f."project_flag_fl",
f."successful_contact_last_year",
f."chk_name_filled",
f."chk_phone_10_digits",
f."chk_phone_russian_code",
f."chk_phone_not_same",
f."chk_phone_not_test",
f."chk_phone_valid",
f."chk_inn_exists",
f."chk_inn_digits",
f."chk_inn_length",
f."chk_inn10_control",
f."chk_inn12_control",
f."chk_inn_valid",
f."already_has",
f."phone_conflict",
case when already_has = 0
    and phone_conflict = 0
	and chk_name_filled = 1
	and chk_phone_valid = 1
	and chk_inn_valid = 1
	and successful_contact_last_year = 0
	--and chk_fl_inn_valid = 1
--	and  project_flag_UL = 1
--	and cnt_inn_per_phone = 1
	and chk_phone_russian_code = 1
	then 1 else 0 end as "Заливаем в 3 волну",
	case when already_has = 0
    and phone_conflict = 0
	and chk_name_filled = 1
	and chk_phone_valid = 1
	and chk_inn_valid = 1
	--and successful_contact_last_year = 0
	--and chk_fl_inn_valid = 1
--	and  project_flag_UL = 1
--	and cnt_inn_per_phone = 1
	and chk_phone_russian_code = 1
	then 1 else 0 end as "Заливаем в 3 волну без условия на наличие успешного контакта"
from "filter" f;




