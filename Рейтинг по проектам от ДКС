drop table if exists "dks_projects"; -- все проекты дкс за нужный период
create temp table "dks_projects" as
with a as(
select 
         tapd."Номер проекта"
        ,case 
                when lc."type" = 1 then 'Исходящие'
                else 'Входящие'
         end "ДКС"
        ,t."payload_type"
        ,row_number() over(partition by li.project_id order by li.started) rn
from 
     	"tt_all_projects_data" tapd	
    ----
 	join voipclient."leasing_interaction" li 
 		on li."project_id" =  tapd."Номер проекта" 
 		and  li."started" between '2025-01-01' and current_date 
    ----
 	join voipclient."leasing_task" t
        on li."task"=t."id"
 	----
 	join voipclient."leasing_campaign" lc 
 		on lc."id" = t."campaign"
)
select 
         a."Номер проекта"
        ,a."ДКС"
        ,a."payload_type"
        ,case 
        	when "payload_type" = 'partners' and "ДКС" = 'Входящие' then 'Поставщики'
        	when "payload_type" != 'partners' and "ДКС" = 'Входящие' then 'Входящие'
        	else 'Исходящие'
        end "ДКС_final"
from 
        a
where 
        rn = 1
;


