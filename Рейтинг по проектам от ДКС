drop table if exists "tt_project_channels";
create temp table "tt_project_channels"  as
with a as (
select 
	tapd."Номер проекта"
	,coalesce(dp."ДКС_final", tapd."Группа источника обращения") "Канал"
from "tt_all_projects_data" tapd
	---------
	left join "dks_projects" dp
           on dp."Номер проекта" =  tapd."Номер проекта"
 )
  select 
   a."Номер проекта"
  ,case 
  	when "Канал" = 'Входящие' then 'Входящие'
  	when "Канал" = 'Исходящие' then 'Исходящие'
  	when "Канал" like '%Поставщик%' then 'Поставщики'
  	else 'МОП'
  end "Канал продаж"
  from a
 ;


