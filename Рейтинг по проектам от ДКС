drop table if exists "tt_purchases"; -- собираем покупки ТС по проекту
create temp table "tt_purchases" as
select 
	 tapd."Номер проекта"
	 ,count(case when ap."Источник" = 'ЕП' then ap."Key" end) "Кол-во ТС в ЕП"
	 ,count(case when ap."Источник" = 'ЕФРС' then ap."Key" end) "Кол-во ТС НЕ в ЕП"
	 ,min(case when ap."Источник" = 'ЕП' then ap."ДатаПокупки" end) "Дата первой покупки в ЕП"
	 ,min(case when ap."Источник" = 'ЕФРС' then ap."ДатаПокупки" end) "Дата первой покупки НЕ в ЕП"
from "tt_all_projects_data" tapd
	left join dwh."AllPurchases" ap 
		 on tapd."CtaRepositoryId" = ap."CtaRepositoryId"
		and ap."ДатаПокупки" between tapd."Дата создания проекта" and tapd."Дата создания проекта" + interval'60 days'
		and ap."IsPurchase" is true 
		and ap."Источник" in ('ЕП', 'ЕФРС')
group by 
	tapd."Номер проекта"
;


