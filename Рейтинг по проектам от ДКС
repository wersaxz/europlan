drop table if exists "tt_leasing_transfer"; -- собираем передачи по проекту и ЧИ с проекта
create temp table "tt_leasing_transfer" as
select 
	 tapd."Номер проекта"
	,min (dl."ДатаПередачи") :: date "Первая дата передачи" 
	,sum(dl."ЧИ") "ЧИ проекта"
	,count(dl."ProjectId") "Кол-во переданных ДФЛ в проекте"
from 
			  "tt_all_projects_data" tapd
	---------
	left join dwh."IC_ДоговорЛизинга" dl
		 on tapd."Номер проекта" = dl."ProjectId"
		and dl."ДатаПередачи" between tapd."Дата создания проекта" and tapd."Дата создания проекта"+ interval'60 days'
group by 
	 tapd."Номер проекта";



