drop table if exists "tt_all_projects_data"; -- собираем все проекты всех каналов с 2023, присваиваем им этап, статус и причину архива
create temp table "tt_all_projects_data" as
with a as (
select 
	 sp."Номер проекта"
	,sp."Дата создания проекта"
	,sp."Группа источника обращения"
	,sp."Этап"
	,sp."ЭтапID"
	,sp."Статус"
	,sp."СтатусID"
	,sp."CtaRepositoryId"
	,sp."BranchId"
	--,first_value (psl."RejectionReasonId") over (partition by psl."ProjectId" order by psl."CreatedAt" desc) "RejectionReasonId"
	,row_number () over (partition by psl."ProjectId" order by psl."CreatedAt" desc) rn
	,psl."CreatedAt" "Последняя дата работы над проектом"
	,psl."RejectionReasonId"
	,rr."Name"
	,psl."Description"
from 
		 dwh."SAFO_Project" sp
	----
	left join safo."Projects_StatusLog" psl
		on sp."Номер проекта"  = psl."ProjectId" 
		and sp."Дата создания проекта" > '2025-01-01' 
	----
	left join safo."Projects_RejectionReason" rr
	  on rr."id" = psl."RejectionReasonId"
)
select * from a
where rn = 1
;


drop table if exists "tt_projects_postponed"; -- собираем по всем проектам факт подготовки ПЛ
create temp table "tt_projects_postponed" as
with a as (
select 
	 distinct sp."Номер проекта"
	,sp."Дата создания проекта"
	,psl."StatusId"
	,ps."StageId"
	,min(psl."CreatedAt") as "Дата подготовки первого ПЛ"
	,count(sp."Номер проекта") "Кол-во направления в Отложенные"
from 
		 "tt_all_projects_data" sp
	----
	left join safo."Projects_StatusLog" psl
		on sp."Номер проекта"  = psl."ProjectId" 
		and sp."Дата создания проекта" > '2025-01-01' 
	---------
	left join safo."Projects_Status" ps --select * from safo."Projects_Status"
		   on ps."id" = psl."StatusId"
where psl."StatusId"=4
group by 
	 sp."Номер проекта"
	,sp."Дата создания проекта"
	,psl."StatusId"
	,ps."StageId"
-- 10 этап = отложенные
)
select 
	  distinct a."Номер проекта"
	 ,"Кол-во направления в Отложенные"
	 ,"Дата подготовки первого ПЛ"
from a
;
