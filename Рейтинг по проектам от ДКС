drop table if exists tt_rep; -- собираем клиентов по ГК
create temp table tt_rep as
select 
  coalesce(cc."GroupByOwnerId", -cc."CtaRepositoryId") gbo_id
 ,cc."CtaRepositoryId"
 ,cc."BranchId"
from dwh."Cta_Counteragents" cc;



drop table if exists tt_new_gbo_or_old_gbo; --ищем даты первых передач для всех ГК
create temp table tt_new_gbo_or_old_gbo as
select
     tr.gbo_id
    ,min(dl."ДатаПередачи") :: date first_transfer_by_gbo
from 
          tt_rep tr 
    ----
    left join dwh."IC_ДоговорЛизинга" dl
         on dl."CtaRepositoryId" = tr."CtaRepositoryId"
group by
     tr.gbo_id;


drop table if exists "tt_leasing_transf"; -- ищем первую дату передачи по текущему проекту
create temp table "tt_leasing_transf" as
select 
  sp."Номер проекта"
 ,sp."BranchId"
 ,min (dl."ДатаПередачи") :: date "Первая дата передачи" 
from 
     dwh."SAFO_Project" sp
    
---------
left join dwh."IC_ДоговорЛизинга" dl
   on sp."Номер проекта" = dl."ProjectId"

group by 
  sp."Номер проекта"
 ,sp."BranchId"
  ;


drop table if exists tt_cte_repeat_final; -- собираем все вместе с смотрим, соответствует ли дата передачи по текущему проекту первой дате передачи по ГК
create temp table tt_cte_repeat_final as
select 
  distinct tapd."Номер проекта"
   
    ,tapd."CtaRepositoryId"
    ,tr."gbo_id"
    ,lt2."BranchId"
    ,case 
     when tnog."first_transfer_by_gbo" = lt2."Первая дата передачи" then '0'
     when tnog."first_transfer_by_gbo" is null then '0'
     else '1'
    end "Повторный клиент по ЮЛ/ГК"
from 
      tt_all_projects_data tapd
left join tt_leasing_transf lt2
     on lt2."Номер проекта" = tapd."Номер проекта"
join tt_rep tr 
           on tapd."CtaRepositoryId" = tr."CtaRepositoryId" 
    left join 
       tt_new_gbo_or_old_gbo tnog
        on tnog."gbo_id" = tr."gbo_id"
;





