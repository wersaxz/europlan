drop table if exists "tt_cwc"; --- Время звонка по проекту
create temp table "tt_cwc" as
with a as(
select 
	 tblk.*
	,cwc.event_datetime_utc  "Время звонка"
	,row_number() over(partition by tblk."Дата создания проекта" order by cwc.event_datetime_utc) rw
from
		 "tt_all_projects_data" tblk
	left join dwh."ContactsWithCounteragents" cwc --- select * from  dwh."ContactsWithCounteragents" cwc 
		 on tblk."CtaRepositoryId" = cwc."CtaRepositoryId"
		and tblk."BranchId" = cwc."BranchId"
		and cwc.event_datetime_utc  > tblk."Дата создания проекта"
		and cwc.event_datetime_utc  < tblk."Дата создания проекта"+ interval '5 days'
		and cwc."event_type" in (4, 5, 11, 12, 24, 25, 29, 30)
	)
select 
	*
from 
	a
where 
	rw = 1 and "Время звонка" is not null
;


