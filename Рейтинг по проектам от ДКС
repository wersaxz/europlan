drop table if exists "tt_pre_final_1"; -- собираем инфо по проектам, МОП, Повторности контрагента
create temp table "tt_pre_final_1" as
select 
	 tapd."Номер проекта"
	,tapd."Дата создания проекта" 
	,tpc."Канал продаж"
	,tapd."Последняя дата работы над проектом" 
	,tapd."Этап"
	,tapd."Статус"
	,tapd."Name" "Причина Архива"
	,case 
		when tapd."Name"= 'Отправлен в архив системой по истечении максимального срока бездействия по проекту' then 1
		else 0
	end "Автоархив"
	,tapd."Description" "Комментарий при Архивации проекта"
	,tapdps."Предыдущий статус проекта"
	,tapdps."Предыдущая дата работы над проектом" 
	,tapd."CtaRepositoryId"
	,tapd."BranchId"
	,tcrf."Повторный клиент по ЮЛ/ГК"
	,case 
		when tmfp."Подразделение" = 'Сектор прямых продаж ДКС' then 'Проект на МПП ДКС'
		else 'Проект на другой функции'
	end "МПП"
	,tmfp."Сотрудник"
	,tmfp."Должность"
	,tmfp."Подразделение"
	,tmfp."Логин"
	,case 
		when tmfp."Наименование отдела" = 'Отдел по работе с клиентами ЛО (Рудыкин Д.)' then 'ЦД Ленинградская область'
		when tmfp."Центр прибыли" != 'УРК МО' and tmfp."Дивизион" = 'Дивизион Москва' then 'Москва'
		when tmfp."Центр прибыли" ='УРК МО' and tmfp."Дивизион" = 'Дивизион Москва' then 'Московская область'
		else tmfp."Центр дохода"
	end "ЦД"
	--,tmfp."Центр дохода" "ЦД"
	--,tmfp."Центр прибыли" "ЦП"
	,case 
		when tmfp."Центр прибыли" != 'УРК МО' and tmfp."Дивизион" = 'Дивизион Москва' then 'Москва'
		when tmfp."Центр прибыли" ='УРК МО' and tmfp."Дивизион" = 'Дивизион Москва' then 'Московская область'
		else tmfp."Центр прибыли"
	end "ЦП"
	,tmfp."Дивизион"
	,case
		when tp."Кол-во ТС в ЕП" > 0  or tp."Кол-во ТС НЕ в ЕП" > 0 then 1
		else 0
	end "Покупка где-либо"
	,case
		when tp."Кол-во ТС в ЕП" > 0  then 1
		else 0
	end "Покупка в ЕП"
--	,tpfp."КатегорияТС"
--	,tpfp."Тип ПЛ"
--	,tpfp."Марка"
--	,tpfp."Номер ПЛ из проекта"
	,tp."Кол-во ТС в ЕП"
	,tp."Кол-во ТС НЕ в ЕП"
	,tp."Дата первой покупки в ЕП"
	,tp."Дата первой покупки НЕ в ЕП"
	,case 
		when tlt."Первая дата передачи" is not null then 1
		else 0
	end "Передача"
	,tlt."Первая дата передачи"
	,tlt."ЧИ проекта"
	,tlt."Кол-во переданных ДФЛ в проекте"
	,concat('http://fo.europlan.ru/ctaCard/cta/', tapd."CtaRepositoryId") "Ссылка на карту контрагента"
	,row_number () over (partition by tapd."Номер проекта") "Проект"
	,dbti."Был статус Требует согласования"
	,dbti."Возвращен в КЦ"
	,dbti."Назначена встреча"
	,case 
		when tpp."Номер проекта" is not null then 1
		else 0
	 end "Было подготовлено ПЛ"
	,case 
		when twc."Время звонка" is not null then 1
		else 0
	 end "Был результативный звонок"
	,tpp."Дата подготовки первого ПЛ"
	,twc."Время звонка"
from  "tt_all_projects_data" tapd
	 ---------
	 left join "tt_cte_repeat_final" tcrf -- подтянули повторность
			on tcrf."Номер проекта" = tapd."Номер проекта"
	 ---------
	 left join "tt_mop_for_projects" tmfp
			on tmfp."Номер проекта" = tapd."Номер проекта"
	 -------
	 left join ds."DCC_Tasks_BA_Info" dbti -- подтянули признак согласования и встречи по проекту ДКС
		    on dbti."ProjectId" = tapd."Номер проекта"
	 ---------
	 left join "tt_leasing_transfer" tlt --подтягиваем передачи по проекту, ЧИ
			on tlt."Номер проекта" = tapd."Номер проекта"
	 ---------	
	 left join "tt_purchases" tp  -- подтянули покупки в ТС
			on tp."Номер проекта" = tapd."Номер проекта"
	 ---------	
	 left join "tt_project_channels" tpc -- подтягиваем канал продаж (4 варианта: Входящий, Исходящий, Поставщики, МОП)
			on tpc."Номер проекта" = tapd."Номер проекта"
	 ---------
	 left join "tt_all_projects_data_previous_status" tapdps -- подтягиваем предыдущий статус по проекту до архива (текущий статус)
	 		on tapdps."Номер проекта" = tapd."Номер проекта"
	--------
	left join "tt_projects_postponed" tpp
    on tpp."Номер проекта" = tapd."Номер проекта"
	 ---------
    left join "tt_cwc" twc
    on twc."Номер проекта"= tapd."Номер проекта"
--	 left join "tt_pl_for_project" tpfp
--	 	    on tpfp."Номер проекта" = tapd."Номер проекта"
;
