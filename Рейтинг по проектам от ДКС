--финализирующая таблица с данными по всем проектам и с настройками, которые были запрошены 
 -- собираем инфо по проектам, МОП, Повторности контрагента

select 
	tpf1."Номер проекта"
	,tpf1."Дата создания проекта"
	,tpf1."Канал продаж"
--	,tpf1."CtaRepositoryId"
--	,tpf1."BranchId"
	,tpf1."Повторный клиент по ЮЛ/ГК"
	,tpf1."МПП"
	,tpf1."Сотрудник"
	,tpf1."Должность"
	,tpf1."Подразделение"
	,tpf1."ЦД"
	,tpf1."ЦП"
	,tpf1."Дивизион"	
	,tpf1."Покупка где-либо"
	,tpf1."Покупка в ЕП"
	,tpf1."Кол-во ТС в ЕП"
	,tpf1."Кол-во ТС НЕ в ЕП"
	,tpf1."Передача"
	,tpf1."ЧИ проекта"
	,tpf1."Автоархив"
	,tpf1."Рабочих часов до подготовки ПЛ"
	,case 
		when tpf1."Рабочих часов до звонка МОП">0 and tpf1."Рабочих часов до звонка МОП"<40 then tpf1."Рабочих часов до звонка МОП" else 0
	end "Рабочих часов до первого результативного звонка"
	,tpf1."Было подготовлено ПЛ"
	,tpf1."Был результативный звонок"
	,1 "Один"
from "tt_pre_final_3"  tpf1
where tpf1."Канал продаж" in ('Входящие' , 'Исходящие')
and "ЦД" != 'Дивизион ДКС'
;



