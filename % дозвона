set language Russian;
SELECT
    CAST([Дата завершения задачи] AS DATE) AS Дата,
    DAY([Дата завершения задачи]) AS Число,
    COUNT(*) AS Всего_записей,
    SUM(CASE WHEN [Был дозвон] = 1 THEN 1 ELSE 0 END) AS С_дозвоном,
    SUM(CASE WHEN [Был дозвон] = 0 THEN 1 ELSE 0 END) AS Без_дозвона,
    FORMAT(ROUND(100.0 * SUM(CASE WHEN [Был дозвон] = 1 THEN 1 ELSE 0 END) / COUNT(*), 2), 'N2') AS Процент_с_дозвоном,
    FORMAT(ROUND(100.0 * SUM(CASE WHEN [Был дозвон] = 0 THEN 1 ELSE 0 END) / COUNT(*), 2), 'N2') AS Процент_без_дозвона
FROM
    report.dcc_ba_tasks_info
WHERE
    [Дата завершения задачи] >= '2025-01-01'
    AND [Дата завершения задачи] < '2026-09-01'
    AND [Канал] = 'Исходящие'
    AND МК LIKE '%МК_Повторные_АМ%'
GROUP BY
    CAST([Дата завершения задачи] AS DATE),
    DAY([Дата завершения задачи])
ORDER BY
    Дата;
