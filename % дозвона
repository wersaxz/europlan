set language Russian;
SELECT
    YEAR([Дата завершения задачи]) AS Год,
    MONTH([Дата завершения задачи]) AS Номер_Месяца,
    DATENAME(MONTH, [Дата завершения задачи]) AS Название_месяца,
    COUNT(*) AS Всего_записей,
    SUM(IIF([Класс закрывающего статуса] = 'Лизинг. Не удалось дозвониться', 0, 1)) AS С_дозвоном,
    SUM(IIF([Класс закрывающего статуса] = 'Лизинг. Не удалось дозвониться', 1, 0)) AS Без_дозвона,
    FORMAT(ROUND(100.0 * SUM(IIF([Класс закрывающего статуса] = 'Лизинг. Не удалось дозвониться', 0, 1)) / COUNT(*), 2), 'N2') AS Процент_с_дозвоном,
    FORMAT(ROUND(100.0 * SUM(IIF([Класс закрывающего статуса] = 'Лизинг. Не удалось дозвониться', 1, 0)) / COUNT(*), 2), 'N2') AS Процент_без_дозвона
FROM
    report.dcc_ba_tasks_info
WHERE
    [Дата завершения задачи] >= '2025-01-01'
    AND [Дата завершения задачи] < '2026-09-01'
    AND [Канал] = 'Исходящие'
    AND МК LIKE '%МК_Повторные_АМ%'
GROUP BY
    YEAR([Дата завершения задачи]),
    MONTH([Дата завершения задачи]),
    DATENAME(MONTH, [Дата завершения задачи])
ORDER BY
    Год,
    Номер_Месяца;




set language Russian;
SELECT
    CAST([Дата завершения задачи] AS DATE) AS Дата,
    DAY([Дата завершения задачи]) AS Число,
    COUNT(*) AS Всего_записей,
    SUM(IIF([Класс закрывающего статуса] = 'Лизинг. Не удалось дозвониться', 0, 1)) AS С_дозвоном,
    SUM(IIF([Класс закрывающего статуса] = 'Лизинг. Не удалось дозвониться', 1, 0)) AS Без_дозвона,
    FORMAT(ROUND(100.0 * SUM(IIF([Класс закрывающего статуса] = 'Лизинг. Не удалось дозвониться', 0, 1)) / COUNT(*), 2), 'N2') AS Процент_с_дозвоном,
    FORMAT(ROUND(100.0 * SUM(IIF([Класс закрывающего статуса] = 'Лизинг. Не удалось дозвониться', 1, 0)) / COUNT(*), 2), 'N2') AS Процент_без_дозвона
FROM
    report.dcc_ba_tasks_info
WHERE
    [Дата завершения задачи] >= '2025-01-01'
    AND [Дата завершения задачи] < '2026-09-01'
    AND [Канал] = 'Исходящие'
    AND МК LIKE '%МК_Повторные_АМ%'
GROUP BY
    CAST([Дата завершения задачи] AS DATE),
    DAY([Дата завершения задачи])
ORDER BY
    Дата;
