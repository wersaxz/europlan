--================================================================
-- Срок жизни задачи ИСКЦ: исходящий и входящий каналы ДКС (без поставщиков)
-- Только задачи, завершившиеся дозвоном (последняя интеракция ≠ недозвон)
-- От завершения первой интеракции до завершения последней
--================================================================

drop table if exists tt_task_life;
create temp table tt_task_life as
select
     i.task
    ,case when lc.type = 1 then 'Исходящий'
          else 'Входящий'
     end                                                                         as "Канал"
    ,min(i.ended)                                                                as first_end
    ,max(i.ended)                                                                as last_end
    ,count(*)                                                                    as cnt_interactions
    ,count(*) filter (where cc.name is distinct from 'leasing.call_failed')      as cnt_dialogs        -- состоявшиеся диалоги
    ,(array_agg(cc.name order by i.ended desc))[1]                               as last_class_name    -- класс последней интеракции
from voipclient.leasing_task t
    join voipclient.leasing_campaign lc
        on lc.id = t.campaign
       and lc.type in (1, 2, 3)                          -- 1 = исходящий, 2 = входящие звонки, 3 = заявки
    join voipclient.leasing_interaction i
        on i.task = t.id
       and i.ended is not null
       --and i.operator != 1                             -- раскомментировать, чтобы исключить бота-автодозвон
    left join voipclient.configuration_status cs
        on cs.id = i.status
    left join voipclient.configuration_class cc
        on cc.id = cs.class
where t.status in (122, 233)                             -- задача завершена
  and coalesce(t.payload_type, '') <> 'partners'         -- исключаем поставщиков
  and t.created_at >= current_date - interval '2 years'  -- ограничение для скорости, на результат не влияет
group by
     i.task
    ,2
having max(i.ended) >= current_date - interval '1 year'
   and max(i.ended) <  current_date
;

--================================================================
-- Отбор: задача завершилась дозвоном
--================================================================
drop table if exists tt_task_life_dial;
create temp table tt_task_life_dial as
select
     "Канал"
    ,case when cnt_dialogs >= 2 then '2+ диалога' else '1 диалог' end      as "Диалогов в задаче"
    ,cnt_interactions
    ,cnt_dialogs
    ,extract(epoch from (last_end - first_end))::numeric / 86400           as days
from tt_task_life
where last_class_name is distinct from 'leasing.call_failed'
;

--================================================================
-- 1. Распределение по каналам, числу диалогов и корзинам 0–10 … 100+
--================================================================
with g as (
    select
         case when days >= 100 then 100 else floor(days / 10)::int * 10 end as bucket
        ,*
    from tt_task_life_dial
)
select
     "Канал"
    ,"Диалогов в задаче"
    ,case when bucket = 100 then '100+'
          else bucket || '–' || (bucket + 10)
     end                                                                                          as "Срок жизни, дн."
    ,count(*)                                                                                     as "Кол-во задач"
    ,round(100.0 * count(*) / sum(count(*)) over (partition by "Канал", "Диалогов в задаче"), 1)  as "Доля в группе, %"
    ,round(avg(days), 1)                                                                          as "Среднее, дн."
    ,round(avg(cnt_dialogs), 1)                                                                   as "Среднее кол-во диалогов"
from g
group by
     "Канал"
    ,"Диалогов в задаче"
    ,bucket
order by
     "Канал"
    ,"Диалогов в задаче"
    ,bucket
;

--================================================================
-- 2. Итого: среднее, медиана, перцентили по каналам и числу диалогов
--================================================================
select
     "Канал"
    ,"Диалогов в задаче"
    ,count(*)                                                                     as "Кол-во задач"
    ,round(avg(days), 1)                                                          as "Среднее, дн."
    ,round(percentile_cont(0.5)  within group (order by days)::numeric, 1)        as "Медиана, дн."
    ,round(percentile_cont(0.75) within group (order by days)::numeric, 1)        as "75-й перцентиль, дн."
    ,round(percentile_cont(0.9)  within group (order by days)::numeric, 1)        as "90-й перцентиль, дн."
    ,round(avg(cnt_dialogs), 1)                                                   as "Среднее кол-во диалогов"
from tt_task_life_dial
group by
     "Канал"
    ,"Диалогов в задаче"
order by
     "Канал"
    ,"Диалогов в задаче"
;
