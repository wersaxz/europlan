--================================================================
-- Срок жизни цепочки разговоров по задаче ИСКЦ
-- Исходящий и входящий каналы ДКС (без поставщиков)
-- От завершения первого разговора до завершения последнего
--================================================================

drop table if exists tt_task_dialogs;
create temp table tt_task_dialogs as
select
     i.task
    ,case when lc.type = 1 then 'Исходящий'
          else 'Входящий'
     end                                                                              as "Канал"
    ,count(*)                                                                         as cnt_interactions
    ,count(*)     filter (where cc.name is distinct from 'leasing.call_failed')       as cnt_dialogs        -- разговоры
    ,min(i.ended) filter (where cc.name is distinct from 'leasing.call_failed')       as first_dialog_end
    ,max(i.ended) filter (where cc.name is distinct from 'leasing.call_failed')       as last_dialog_end
    ,max(i.ended)                                                                     as last_end           -- последняя интеракция (для периода)
    ,(array_agg(cc.name order by i.ended desc))[1]                                    as last_class_name
from voipclient.leasing_task t
    join voipclient.leasing_campaign lc
        on lc.id = t.campaign
       and lc.type in (1, 2, 3)                          -- 1 = исходящий, 2 = входящие звонки, 3 = заявки
    join voipclient.leasing_interaction i
        on i.task = t.id
       and i.ended is not null
       --and i.operator != 1                             -- раскомментировать, чтобы исключить бота-автодозвон
    left join voipclient.configuration_status cs
        on cs.id = i.status
    left join voipclient.configuration_class cc
        on cc.id = cs.class
where t.status in (122, 233)                             -- задача завершена
  and coalesce(t.payload_type, '') <> 'partners'         -- исключаем поставщиков
  and t.created_at >= current_date - interval '2 years'  -- ограничение для скорости, на результат не влияет
group by
     i.task
    ,2
having max(i.ended) >= current_date - interval '1 year'
   and max(i.ended) <  current_date
   and count(*) filter (where cc.name is distinct from 'leasing.call_failed') >= 1   -- был хотя бы один разговор
;

drop table if exists tt_chain;
create temp table tt_chain as
select
     "Канал"
    ,case when cnt_dialogs >= 2 then '2+ разговора' else '1 разговор' end                      as "Разговоров в задаче"
    ,cnt_dialogs
    ,extract(epoch from (last_dialog_end - first_dialog_end))::numeric / 86400                 as days
from tt_task_dialogs
--where last_class_name is distinct from 'leasing.call_failed'   -- раскомментировать для старого фильтра «завершилась дозвоном»
;

--================================================================
-- 1. Сводка: сколько задач с 1 и 2+ разговорами
--================================================================
select
     "Канал"
    ,"Разговоров в задаче"
    ,count(*)                                                                    as "Кол-во задач"
    ,round(100.0 * count(*) / sum(count(*)) over (partition by "Канал"), 1)      as "Доля в канале, %"
    ,round(avg(cnt_dialogs), 1)                                                  as "Среднее кол-во разговоров"
from tt_chain
group by
     "Канал"
    ,"Разговоров в задаче"
order by
     "Канал"
    ,"Разговоров в задаче"
;

--================================================================
-- 2. Распределение цепочек (2+ разговора) по корзинам 0–10 … 100+
--================================================================
with g as (
    select
         case when days >= 100 then 100 else floor(days / 10)::int * 10 end as bucket
        ,*
    from tt_chain
    where cnt_dialogs >= 2
)
select
     "Канал"
    ,case when bucket = 100 then '100+'
          else bucket || '–' || (bucket + 10)
     end                                                                         as "Срок цепочки, дн."
    ,count(*)                                                                    as "Кол-во задач"
    ,round(100.0 * count(*) / sum(count(*)) over (partition by "Канал"), 1)      as "Доля в канале, %"
    ,round(avg(days), 1)                                                         as "Среднее, дн."
    ,round(avg(cnt_dialogs), 1)                                                  as "Среднее кол-во разговоров"
from g
group by
     "Канал"
    ,bucket
order by
     "Канал"
    ,bucket
;

--================================================================
-- 3. Итого по цепочкам (2+ разговора): среднее, медиана, перцентили
--================================================================
select
     "Канал"
    ,count(*)                                                                     as "Кол-во задач"
    ,round(avg(days), 1)                                                          as "Среднее, дн."
    ,round(percentile_cont(0.5)  within group (order by days)::numeric, 1)        as "Медиана, дн."
    ,round(percentile_cont(0.75) within group (order by days)::numeric, 1)        as "75-й перцентиль, дн."
    ,round(percentile_cont(0.9)  within group (order by days)::numeric, 1)        as "90-й перцентиль, дн."
    ,round(avg(cnt_dialogs), 1)                                                   as "Среднее кол-во разговоров"
from tt_chain
where cnt_dialogs >= 2
group by "Канал"
order by "Канал"
;
