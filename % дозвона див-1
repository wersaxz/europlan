with params as (
    select date '2026-01-01' as dt_from
          ,date '2027-01-01' as dt_to
),
tasks as (
    select
         t.id         as task_id
        ,t.created_at
    from voipclient.leasing_task t
        join voipclient.leasing_campaign lc
            on t.campaign = lc.id
           and lc."type" = 1
        cross join params p
    where t.created_at >= p.dt_from - interval '6 months'
      and t.created_at <  p.dt_to
),
last_int as (
    select distinct on (i.task)
         i.task     as task_id
        ,i.ended
        ,cc."name"  as class_name
    from voipclient.leasing_interaction i
        join tasks t on t.task_id = i.task
        left join voipclient.configuration_status cs on i.status = cs.id
        left join voipclient.configuration_class  cc on cs."class" = cc.id
    where i.ended is not null
    order by i.task, i.ended desc
)
select
     t.task_id                                   as "Номер задачи"
    ,'Исходящие'                                 as "Канал"
    ,t.created_at::date                          as "Дата создания задачи"
    ,l.ended::date                               as "Дата завершения задачи"
    ,case when l.class_name = 'leasing.call_failed' then 0 else 1 end as "Дозвон"
    ,b."Дивизион по МОП"                         as "Дивизион МОП"
    ,b."Дивизион по контрагенту"                 as "Дивизион по контрагенту"
from tasks t
    join last_int l on l.task_id = t.task_id
    cross join params p
    left join ds."DCC_Tasks_BA_Info" b on b."TaskId" = t.task_id
where l.ended >= p.dt_from
  and l.ended <  p.dt_to
order by t.task_id;
