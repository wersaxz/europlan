select
     li."status"
    ,cs."class"        as status_class
    ,cc."name"         as class_name
    ,count(*)          as "Итераций"
    ,round(avg(extract(epoch from (li."ended" - li."started"))))::int as "Ср_сек"
from voipclient."leasing_interaction" li
    join voipclient."leasing_task" lt on lt."id" = li."task"
    left join voipclient."configuration_status" cs on cs."id" = li."status"
    left join voipclient."configuration_class"  cc on cs."class" = cc."id"
where lt."campaign" = 204
  and li."started" is not null
group by li."status", cs."class", cc."name"
order by count(*) desc;
