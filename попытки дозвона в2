select count(*) as "Попыток без лимита из истории"
from voipclient."leasing_interaction" li
    join voipclient."leasing_task" lt on lt."id" = li."task"
    left join (
        select "campaign","count_attempts"
            ,case when row_number() over (partition by "campaign" order by "updated_at")=1
                  then '-infinity'::timestamp else "updated_at" end as date_from
            ,coalesce(lead("updated_at") over (partition by "campaign" order by "updated_at"),'infinity'::timestamp) as date_to
        from voipclient."leasing_campaign_history" where "count_attempts">0
    ) lh on lh."campaign"=lt."campaign" and li."started">=lh.date_from and li."started"<lh.date_to
where lt."campaign"=204 and li."started" is not null and lh."count_attempts" is null;
