--================================================================
-- МК 204 (исходящий): на какой попытке дозвона заводится проект
-- Попытки режутся на ГРУППЫ. Группа закрывается ДОЗВОНОМ (клиент взял трубку)
-- либо блоком номера на 4-й попытке автодозвона (лимит МК 204 = 4).
-- Счётчик попыток сбрасывается в начале каждой новой группы.
-- Для задач БЕЗ проекта выводится размер последней группы
-- (чистый недозвон = 4; единичный дозвон-и-закрытие = 1).
-- Фильтр: дата завершения задачи >= 17.06.2026
--================================================================

with recursive

t204 as (
    select
         lt."id"          as "TaskId"
        ,lt."created_at"  as "Дата создания задачи"
    from voipclient."leasing_task" lt
        join voipclient."leasing_campaign" lc
            on lc."id" = lt."campaign"
    where lt."campaign" = 204
      and lc."type" = 1
),

attempts as (
    -- каждая итерация = попытка; размечаем недозвон по ЯВНОМУ списку статусов
    select
         li."task"        as "TaskId"
        ,li."id"          as "InteractionId"
        ,li."started"
        ,li."ended"
        ,li."project_id"
        ,case
            when (cs."class" = 9 or li."status" = 59)   -- общее правило из памятки
              or li."status" in ( 493 )                 -- <<< НЕДОЗВОН МК 204: дополнить по диагностике
            then 0                                      -- 0 = недозвон
            else 1                                      -- 1 = дозвон
         end as "Дозвон"
        ,row_number() over (partition by li."task"
                            order by li."started", li."id") as "seq"
    from voipclient."leasing_interaction" li
        join t204 t on t."TaskId" = li."task"
        left join voipclient."configuration_status" cs on cs."id" = li."status"
    where li."started" is not null
),

grouped as (
    select
         a."TaskId", a."InteractionId", a."seq", a."started", a."ended"
        ,a."Дозвон", a."project_id"
        ,1 as "Попытка в группе"
        ,1 as "Номер группы"
        ,case when a."Дозвон" = 1 or 1 >= 4 then 1 else 0 end as "Группа закрыта"
    from attempts a
    where a."seq" = 1

    union all

    select
         a."TaskId", a."InteractionId", a."seq", a."started", a."ended"
        ,a."Дозвон", a."project_id"
        ,case when g."Группа закрыта" = 1 then 1
              else g."Попытка в группе" + 1 end                       as "Попытка в группе"
        ,case when g."Группа закрыта" = 1 then g."Номер группы" + 1
              else g."Номер группы" end                               as "Номер группы"
        ,case
            when a."Дозвон" = 1 then 1                                 -- дозвон закрывает группу
            when (case when g."Группа закрыта" = 1 then 1
                       else g."Попытка в группе" + 1 end) >= 4 then 1  -- блок на 4-й попытке
            else 0
         end as "Группа закрыта"
    from attempts a
        join grouped g
            on g."TaskId" = a."TaskId"
           and a."seq" = g."seq" + 1
),

proj_row as (
    -- попытка (внутри группы), на которой ВПЕРВЫЕ появился проект
    select distinct on (g."TaskId")
         g."TaskId", g."project_id"
        ,g."Попытка в группе" as "Попытка проекта"
    from grouped g
    where g."project_id" is not null
    order by g."TaskId", g."seq"
),

last_row as (
    -- размер последней группы (для задач без проекта)
    select distinct on (g."TaskId")
         g."TaskId"
        ,g."Попытка в группе" as "Попытка последней группы"
    from grouped g
    order by g."TaskId", g."seq" desc
),

agg as (
    select
         t."TaskId", t."Дата создания задачи"
        ,max(g."ended")                                              as "Дата завершения задачи"
        ,max(case when g."project_id" is not null then 1 else 0 end) as "Факт заведения проекта"
    from grouped g
        join t204 t on t."TaskId" = g."TaskId"
    group by t."TaskId", t."Дата создания задачи"
)

select
     ag."Дата создания задачи"::date    as "Дата создания задачи"
    ,ag."Дата завершения задачи"::date  as "Дата завершения задачи"
    ,ag."TaskId"                        as "Номер задачи"
    ,coalesce(pr."Попытка проекта", lr."Попытка последней группы")
                                        as "Количество попыток дозвона"
    ,ag."Факт заведения проекта"
    ,coalesce(sp."Номер проекта", pr."project_id")
                                        as "Номер проекта"
from agg ag
    left join proj_row pr on pr."TaskId" = ag."TaskId"
    left join last_row  lr on lr."TaskId" = ag."TaskId"
    left join dwh."SAFO_Project" sp on sp."Номер проекта" = pr."project_id"
where ag."Дата завершения задачи" >= '2026-06-17'
order by ag."Дата завершения задачи" desc
;
