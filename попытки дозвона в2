--================================================================
-- Отчёт по МК 204 (исходящий): на какой попытке дозвона заводится проект
-- Источник истины по попыткам — dcc."FT_efficiency_of_dialing_attempts"()
-- (продакшен-функция, отчёт "Эффективность МПП"). Собственную нарезку
-- на группы НЕ делаем — берём dailing_indicator из функции.
-- Фильтр: дата завершения задачи >= 17.06.2026
--================================================================

with

t204 as (
    -- задачи МК 204, исходящий канал
    select
         lt."id"          as task
        ,lt."created_at"  as created_at
    from voipclient."leasing_task" lt
        join voipclient."leasing_campaign" lc on lc."id" = lt."campaign"
    where lt."campaign" = 204
      and lc."type" = 1
),

task_end as (
    -- дата завершения задачи = последняя итерация
    select li."task" as task, max(li."ended") as ended
    from voipclient."leasing_interaction" li
        join t204 t on t.task = li."task"
    group by li."task"
),

fn as (
    -- вызов производственной функции, оставляем только МК 204
    select f.task, f.project, f.dailing_indicator
    from dcc."FT_efficiency_of_dialing_attempts"() f
    where f.campaign = 204
),

fn_agg as (
    -- сворачиваем функцию до задачи
    select
         f.task
        ,max(case when f.project is not null then 1 else 0 end)            as has_project
        ,max(case when f.project is not null then f.dailing_indicator end) as dialing_at_project  -- попытка, на которой завёлся проект
        ,max(f.dailing_indicator)                                          as dialing_max         -- полный размах попыток (для задач без проекта)
    from fn f
    group by f.task
),

proj as (
    -- реальный номер проекта (функция даёт только флаг = task_id)
    select distinct on (li."task")
         li."task"        as task
        ,li."project_id"  as project_id
    from voipclient."leasing_interaction" li
        join t204 t on t.task = li."task"
    where li."project_id" is not null
    order by li."task", li."started"
)

select
     t.created_at::date                              as "Дата создания задачи"
    ,te.ended::date                                  as "Дата завершения задачи"
    ,t.task                                          as "Номер задачи"
    ,coalesce(fa.dialing_at_project, fa.dialing_max) as "Количество попыток дозвона"
    ,coalesce(fa.has_project, 0)                     as "Факт заведения проекта"
    ,coalesce(sp."Номер проекта", pr.project_id)     as "Номер проекта"
from t204 t
    left join task_end te on te.task = t.task
    left join fn_agg  fa on fa.task = t.task
    left join proj    pr on pr.task = t.task
    left join dwh."SAFO_Project" sp on sp."Номер проекта" = pr.project_id
where te.ended >= '2026-06-17'
order by te.ended desc
;
