select
     f.task
    ,f.campaign
    ,f.dailing_indicator
    ,count(*) as cnt
from dcc."FT_efficiency_of_dialing_attempts"() f
where f.task = 21742772
group by f.task, f.campaign, f.dailing_indicator
order by f.campaign, f.dailing_indicator;


select
     task
    ,max(dailing_indicator)     as max_ind
    ,max(dailing_indicator) + 1 as итог
    ,count(*)                   as строк
from dcc."FT_efficiency_of_dialing_attempts"()
where campaign = 204 and task = 21742772
group by task;
