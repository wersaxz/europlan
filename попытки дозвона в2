with recursive
params as (select 204 as campaign_id),
limit_hist as (
    select lch."campaign", lch."count_attempts"
        ,lch."updated_at" as date_from
        ,coalesce(lead(lch."updated_at") over (partition by lch."campaign" order by lch."updated_at"),'infinity'::timestamp) as date_to
    from voipclient."leasing_campaign_history" lch cross join params p
    where lch."campaign"=p.campaign_id and lch."count_attempts">0
),
attempts as (
    select li."task" as task, li."id" as interaction_id, li."started", li."ended", li."project_id"
        ,case when (cs."class"<>9 and li."status"<>59) or (cs."class" is null and li."status" is null) then 1 else 0 end as dozvon
        ,li."status", cs."class" as status_class
        ,row_number() over (partition by li."task" order by li."started", li."id") as seq
        ,coalesce(lh."count_attempts",4) as attempt_limit
    from voipclient."leasing_interaction" li
        join voipclient."leasing_task" lt on lt."id"=li."task"
        cross join params p
        left join voipclient."configuration_status" cs on cs."id"=li."status"
        left join limit_hist lh on li."started">=lh.date_from and li."started"<lh.date_to
    where lt."campaign"=p.campaign_id and li."started" is not null
),
walk as (
    select a.task,a.interaction_id,a.seq,a."started",a."ended",a.dozvon,a.project_id,a.attempt_limit,a."status",a.status_class
        ,1 as attempt_in_grp,1 as grp
        ,case when a.dozvon=1 or 1>=a.attempt_limit then 1 else 0 end as grp_closed
    from attempts a where a.seq=1
    union all
    select a.task,a.interaction_id,a.seq,a."started",a."ended",a.dozvon,a.project_id,a.attempt_limit,a."status",a.status_class
        ,case when w.grp_closed=1 then 1 else w.attempt_in_grp+1 end
        ,case when w.grp_closed=1 then w.grp+1 else w.grp end
        ,case when a.dozvon=1 then 1
              when (case when w.grp_closed=1 then 1 else w.attempt_in_grp+1 end)>=a.attempt_limit then 1
              else 0 end
    from attempts a join walk w on w.task=a.task and a.seq=w.seq+1
)
select seq, "started"::timestamp as started, "status", status_class, dozvon,
       attempt_limit, grp, attempt_in_grp, grp_closed, project_id
from walk
where task = 21866984      -- <<< подставь задачу с числом >4
order by seq;
