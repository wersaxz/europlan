WITH RankedProjects AS (
    SELECT *,
           ROW_NUMBER() OVER (PARTITION BY [Номер проекта] ORDER BY ДатаПередачиДФЛ) AS rn
    FROM Report.Daily_ProjectMarketingCommunicationAttribution
    WHERE [Дата проекта] >= '2025.01.01' and [ДатаПередачиДФЛ] is not null
)

SELECT 
    BTI.*
    ,IIF (BTI.[Номер проекта] IS NOT NULL, 1,0) был_создан_проект
    ,IIF([Класс закрывающего статуса] = 'Лизинг. Не удалось дозвониться', 0, 1) [Завершена с дозвоном]
    ,IIF([покупки в лизинг в течение 135 дней после закрытия задачи] > 0 AND [Класс закрывающего статуса] != 'Лизинг. Не удалось дозвониться', 1, 0) [Факт покупки в лизинг в теч 135 дней в дозвонах]
    ,IIF([покупки в лизинг в течение 135 дней после закрытия задачи] > 0 AND BTI.[Номер проекта] IS NOT NULL, 1, 0)  [Факт покупки в лизинг в теч 135 дней в заведенных проектах]
    ,IIF([покупки в лизинг в течение 60 дней после закрытия задачи] > 0 AND BTI.[Номер проекта] IS NOT NULL, 1, 0)  [Факт покупки в лизинг в теч 60 дней в заведенных проектах]
    ,IIF([покупки в ЕП в течение 135 дней после закрытия задачи]>0 and BTI.[номер проекта] is not null,1,0) [Факт покупки в ЕП в теч 135 дней в заведенных проектах ]
    ,IIF([покупки в ЕП в течение 60 дней после закрытия задачи]>0 and BTI.[номер проекта] is not null,1,0) [Факт покупки в ЕП в теч 60 дней в заведенных проектах ]
    -- ИЗМЕНЕНО: добавлено условие дозвона, чтобы недозвоны не попадали в показатель
    ,IIF([покупки не в ЕП в течение 135 дней после закрытия задачи]>0 AND [Класс закрывающего статуса] != 'Лизинг. Не удалось дозвониться',1,0) [Факт покупки не в ЕП в лизинг в теч 135 дней]
    ,IIF([покупки в лизинг в течение 135 дней после закрытия задачи] > 0 AND BTI.[Номер проекта] IS NOT NULL, [покупки в лизинг в течение 135 дней после закрытия задачи] , 0) [Покупки на рынке в заведенных проектах]
    ,IIF([покупки в ЕП в течение 135 дней после закрытия задачи]> 0 AND BTI.[Номер проекта] IS NOT NULL, [покупки в ЕП в течение 135 дней после закрытия задачи] , 0) [Покупки В ЕП в заведенных проектах]
    ,payload_type
    -- ИЗМЕНЕНО: для недозвонов NULL, чтобы не занижать среднее в сводной
    ,CASE 
        WHEN [Класс закрывающего статуса] = 'Лизинг. Не удалось дозвониться' THEN NULL
        WHEN rpj.[Дата проекта] IS NULL OR rpj.[ДатаПередачиДФЛ] IS NULL THEN 0
        ELSE DATEDIFF(DAY, rpj.[Дата проекта], rpj.[ДатаПередачиДФЛ])
     END AS [Дней между созданием проекта и датой первой передачи ДФЛ]
    -- ИЗМЕНЕНО: для недозвонов NULL
    ,CASE 
        WHEN [Класс закрывающего статуса] = 'Лизинг. Не удалось дозвониться' THEN NULL
        WHEN rpj.[Дата проекта] IS NULL OR rpj.[ДатаПередачиДФЛ] IS NULL THEN NULL
        ELSE DATEDIFF(MONTH, rpj.[Дата проекта], rpj.[ДатаПередачиДФЛ])
     END AS [Месяцев между созданием проекта и датой первой передачи ДФЛ]
    ,Category
    ,1 один
FROM  report.dcc_ba_tasks_info BTI
JOIN WarehousePG.voipclient_leasing_task VCLT
    ON BTI.[Номер задачи] = VCLT.id
JOIN WarehousePG.dwh_Cta_Counteragents dcc
    on bti.BranchId = dcc.BranchId
Left join RankedProjects rpj
   on BTI.[Номер проекта]=rpj.[Номер проекта] and rpj.rn=1
WHERE 
    BTI.[Дата завершения задачи] >= DATEADD(MONTH, -16, GETDATE()) 
    -- ИЗМЕНЕНО: было != 'Лизинг. Не удалось дозвониться'; теперь берём и дозвоны, и недозвоны
    AND BTI.[Класс закрывающего статуса] IS NOT NULL
