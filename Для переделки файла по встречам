--================================================================
-- A. cwc: версии и что значит запись типа 30
--    Жду: сколько строк на одну встречу; распределение Answered
--    (один проход по тяжёлой таблице)
--================================================================
select 
     "Answered"
    ,count(*)                  as "Строк"
    ,count(distinct "Id")      as "Уникальных Id"
    ,count(distinct event_id)  as "Уникальных event_id"
from dwh."ContactsWithCounteragents"
where event_type = 30
  and event_datetime_utc >= '2025-01-01'
group by 1
order by 1;


--================================================================
-- B. cwc: пример записей о встречах
--    Жду: есть ли номер проекта в SourceUrl / ResultUrl / тексте,
--    кто в AuthorId
--================================================================
select 
     "Id", "Version", event_id
    ,"CtaRepositoryId", "BranchId"
    ,event_datetime_utc
    ,"AuthorId", "Answered"
    ,"SourceTextData", "SourceUrl", "ResultUrl", comment
from dwh."ContactsWithCounteragents"
where event_type = 30
  and event_datetime_utc >= '2026-09-01'
limit 30;


--================================================================
-- C. «Назначена встреча»: витрина БА vs JSON итерации
--    Жду: насколько два источника совпадают
--================================================================
with ba as (
    select 
         "ProjectId"
        ,max("Назначена встреча") as "БА: назначена"
    from ds."DCC_Tasks_BA_Info"
    where "Prj_CreatedAt" >= '2025-01-01'
      and "ProjectId" is not null
    group by "ProjectId"
)
,js as (
    select distinct on (project_id)
         project_id
        ,project_data #>> '{content,meetingInfo,reasonProjectWithoutMeet,text}' as reason
    from voipclient.leasing_interaction
    where started >= '2025-01-01'
      and project_id is not null
    order by project_id, started
)
select 
     ba."БА: назначена"
    ,case when js.project_id is null then 'нет итерации'
          when js.reason is null     then 'JSON: назначена'
          else 'JSON: не назначена' 
     end as "JSON"
    ,count(*) as "Проектов"
from ba
left join js on js.project_id = ba."ProjectId"
group by 1, 2
order by 1, 2;
