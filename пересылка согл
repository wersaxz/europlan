-- целевые проекты
-- select * from tt_projects
drop table if exists tt_projects;
create temp table tt_projects as
select
        sp."CtaRepositoryId"
        ,li."project_id"
        ,sp."Дата создания проекта"
from
        voipclient.leasing_interaction as li
        join dwh."SAFO_Project" sp
                on li."project_id" = sp."Номер проекта"
where
        "comment" ilike '%иной офис%'
        and project_id is not null
;
-- статусы:
--select * from tt_statuses;
drop table if exists tt_statuses;
create temp table tt_statuses as
with
base as (
        select
                sp."CtaRepositoryId"
                ,sp."project_id" as "Номер проекта"
                ,sp."Дата создания проекта"
--                ,'https://fo.europlan.ru/jd/project/'||sp."project_id" as "Ссылка на проект"
--                ,spsl."Curr_StatusId"
                ,max(spsl."Curr_DateTime") over (partition by sp."project_id" order by spsl."Curr_DateTime" desc) = spsl."Curr_DateTime" as current_status
--                ,spsl."Curr_DateTime"
                ,pt."Name" as "Статус проекта"
        from 
                tt_projects sp
                join dwh."SAFO_Projects_StatusLog" spsl
                        on sp."project_id" = spsl."ProjectId"
                join safo."Projects_Status" pt
                        on spsl."Curr_StatusId" = pt."id"
)
select
        b."CtaRepositoryId"
        ,b."Номер проекта"
        ,b."Дата создания проекта"
        ,b."Статус проекта"
from
        base b
where
        current_status
;
