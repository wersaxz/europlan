--================================================================
-- Потери от фильтра КП «Нет внесённой даты планируемого приобретения
-- более чем за 21 день до даты звонка» (PostgreSQL, db-warehouse-production)
--
-- Одна строка = одна задача ДКС
--
-- Ключевые допущения:
--  * Задачи ДКС всех каналов (leasing_campaign.type 1, 2, 3), без payload_type = 'partners'
--  * Завершающий звонок = последняя завершённая итерация задачи (по ended);
--    в выборку попадают задачи, где этот звонок имеет статус
--    leasing.planned_later «Планирует приобретение позже» или
--    leasing.not_planning_until «Не планирует приобретение до» и заполнена planned
--  * Задачи, где planned не дальше kp_days от звонка, исключаются —
--    фильтр КП их не замораживает
--  * Покупка = dwh."AllPurchases", IsPurchase, Источник 'ЕП' или 'ЕФРС' (не ЕП),
--    дата покупки строго после дня звонка и не позже (планируемая дата - kp_days):
--    за kp_days до планируемой даты фильтр уже пропускает клиента в обзвон
--  * Факт покупки — признак 0/1, количество ТС не считается
--================================================================


--================================================================
-- 0. Параметры
--================================================================
drop table if exists tt_params;
create temp table tt_params as
select
     21                 as kp_days     -- порог фильтра КП, дней
    ,date '2025-01-01'  as date_from   -- завершающие звонки с
    ,current_date       as date_to     -- и до (не включая); период режется в сводных
;


--================================================================
-- 1. Завершающий звонок по каждой задаче ДКС
--================================================================
drop table if exists tt_last_call;
create temp table tt_last_call as
select distinct on (li.task)
     li.task
    ,li.id                                                 as interaction_id
    ,li.status
    ,li.started
    ,li.planned
    ,coalesce(li.cta_repository_id, t.cta_repository_id)  as cta
    ,t.branch_id
    ,lc."type"                                             as campaign_type
from voipclient.leasing_interaction li
join voipclient.leasing_task t
    on t.id = li.task
join voipclient.leasing_campaign lc
    on lc.id = t.campaign
cross join tt_params p
where lc."type" in (1, 2, 3)
  and t.payload_type is distinct from 'partners'
  and li.ended is not null
  and li.started >= p.date_from
order by li.task, li.ended desc, li.id desc
;


--================================================================
-- 2. Задачи, закрытые переносом с датой дальше порога КП
--================================================================
drop table if exists tt_frozen;
create temp table tt_frozen as
select lcall.*
from tt_last_call lcall
join voipclient.configuration_status cs
    on cs.id = lcall.status
cross join tt_params p
where cs.name in ('leasing.planned_later', 'leasing.not_planning_until')
  and lcall.planned is not null
  and lcall.planned > lcall.started + make_interval(days => p.kp_days)
  and lcall.started < p.date_to
  and lcall.cta is not null
;
create index on tt_frozen (cta);
analyze tt_frozen;


--================================================================
-- 3. Покупки за время заморозки: от звонка до (планируемая дата - kp_days)
--================================================================
drop table if exists tt_purch;
create temp table tt_purch as
select
     f.task
    ,max(case when ap."Источник" = 'ЕП'   then 1 else 0 end) as purch_ep
    ,max(case when ap."Источник" = 'ЕФРС' then 1 else 0 end) as purch_not_ep
    ,min(ap."ДатаПокупки")::date                             as first_purch_dt
from tt_frozen f
cross join tt_params p
join dwh."AllPurchases" ap
    on ap."CtaRepositoryId" = f.cta
   and ap."ДатаПокупки"::date >  f.started::date
   and ap."ДатаПокупки"::date <= (f.planned - make_interval(days => p.kp_days))::date   -- до момента, когда фильтр отпускает клиента
   and ap."IsPurchase" is true
   and ap."Источник" in ('ЕП', 'ЕФРС')
group by f.task
;


--================================================================
-- 4. Итог — колонки под сводные Excel
--================================================================
select
     f.task                                                        as "Номер задачи"
    ,f.cta                                                         as "CtaRepositoryId"
    ,f.branch_id                                                   as "BranchId"
    ,case when f.campaign_type = 1 then 'Исходящие' else 'Входящие' end as "Канал"
    ,case f.campaign_type
          when 1 then 'Исходящий'
          when 2 then 'Входящий звонок'
          when 3 then 'Заявка'
     end                                                           as "Канал детально"
    ,f.started::date                                               as "Дата звонка"
    ,f.planned::date                                               as "Дата планируемого звонка"
    ,case when coalesce(pu.purch_ep, 0) = 1
            or coalesce(pu.purch_not_ep, 0) = 1 then 1 else 0 end  as "Факт покупки"
    ,coalesce(pu.purch_ep, 0)                                      as "Факт покупки в ЕП"
    ,coalesce(pu.purch_not_ep, 0)                                  as "Факт покупки не в ЕП"
    ,pu.first_purch_dt                                             as "Дата покупки"   -- первая покупка в окне заморозки (ЕП или не ЕП)
from tt_frozen f
left join tt_purch pu
    on pu.task = f.task
order by f.started
;
