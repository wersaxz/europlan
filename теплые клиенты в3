--================================================================
-- Клиенты сегмента «Банк» (3 волна) с хотя бы 1 покупкой за 3 года
--================================================================
select count(distinct b."инн_контрагента") as "Клиентов с покупкой за 3 года"
from "chk_base" b
where b."wave3" = 1
  and b."Источник банк" = 1
  and exists (
        select 1
        from dwh."Cta_Counteragents" cc
        join dwh."AllPurchases" ap
          on ap."CtaRepositoryId" = cc."CtaRepositoryId"
         and ap."ActualRow" = 1
         and ap."ДатаПокупки" >= current_date - interval '3 years'
         and ap."ДатаПокупки" <  current_date
        where cc."INN" = b."инн_контрагента"
          and cc."RemovedAt" is null
      )
;
