-- =========================================================
-- ОТКАЗЫ ПО СОГЛАСОВАНИЮ — ДКС (все ЦД, Кемерово выберешь в Excel)
--   Отказ = is_prj <> 1 (первое согласование, rn = 1)
--   Период: дата завершения задачи за последние 2 года
--   Окно 60 дн от closed_date; покупки по клиенту (CtaRepositoryId)
-- =========================================================
drop table if exists tmp_coord;
create temp table tmp_coord as
select
     ta.task
    ,ta.closed_date
    ,ta.is_prj
    ,row_number() over (partition by ta.task order by ta.coordination_date) as rn
from dcc."FT_Project_Coordinations"() ta
where ta.closed_date::date >= current_date - interval '2 years';

drop table if exists tmp_refusals;
create temp table tmp_refusals as
select
     c.task
    ,c.closed_date::date                                    as "Дата завершения задачи"
    ,ti."ProjectId"                                         as "Номер проекта"
    ,ti."ЦД МОП"
    ,coalesce(sp."CtaRepositoryId", lt.cta_repository_id)   as "CtaRepositoryId"
    ,c.closed_date::date                                    as d_from
    ,(c.closed_date::date + interval '60 day')::date        as d_to
from tmp_coord c
    join ds."DCC_Tasks_BA_Info"  ti on c.task = ti."TaskId"
    join voipclient.leasing_task lt on ti."TaskId" = lt.id
    left join dwh."SAFO_Project" sp on sp."Номер проекта" = ti."ProjectId"
where c.rn = 1
  and c.is_prj is distinct from 1
  and lt.payload_type <> 'partners';

select
     r.task                     as "Номер задачи"
    ,r."Дата завершения задачи"
    ,r."Номер проекта"
    ,r."ЦД МОП"
    ,case when exists (
        select 1 from dwh."AllPurchases" ap
        where ap."CtaRepositoryId" = r."CtaRepositoryId"
          and ap."IsPurchase" = true and ap."TargetSegment" = true
          and ap."Источник" = 'ЕП'
          and ap."ДатаПокупки"::date between r.d_from and r.d_to
     ) then 1 else 0 end        as "Факт покупки в ЕП 60 дней"
    ,case when exists (
        select 1 from dwh."AllPurchases" ap
        where ap."CtaRepositoryId" = r."CtaRepositoryId"
          and ap."IsPurchase" = true and ap."TargetSegment" = true
          and ap."Источник" in ('ЕП','ЕФРС')
          and ap."ДатаПокупки"::date between r.d_from and r.d_to
     ) then 1 else 0 end        as "Факт покупки в лизинг 60 дней"
from tmp_refusals r
order by r."Дата завершения задачи";
