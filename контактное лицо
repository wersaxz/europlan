        ,c."DependentId" as "PersonCtaRepositoryId" -- это и есть контактное лицо
    from
        cta."CounteragentLinks" c
            join dwh."Cta_Counteragents" cta
                on c."PrincipalId" = cta."CtaRepositoryId" 
                    and cta."RemovedAt" is null
    where
	     exists (select 1 from tt_project_mop p
    				where c."PrincipalId" = p."CtaRepositoryId")
        and c."RemovedAt" is null
        and c."Type" = 1
        and c."BranchId" is null --Branchid is null and type = 1, то контактное лицо есть во всех филиалах Юр лица.
union
    select
         c."PrincipalId" as "CtaRepositoryId"
        ,c."DependentId" as "PersonCtaRepositoryId"
    from
        cta."CounteragentLinks" c
        join dwh."Cta_Counteragents" cta
                on c."PrincipalId" = cta."CtaRepositoryId" 
                    and cta."RemovedAt" is null
    where
    	exists (select 1 from tt_project_mop p
    				where c."PrincipalId" = p."CtaRepositoryId")
        and c."RemovedAt" is null
        and c."Type" = 1
        and c."BranchId" is not null -- Branchid is not null, то контактное лицо есть только в этом бренче
)
