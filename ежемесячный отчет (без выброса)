drop table if exists #atr;
select distinct
iif([Исходный проект ДКС] is null,[Номер проекта],[Исходный проект ДКС]) as [Номер проекта с учетом передач по перезаведенным]
,iif([Исходный проект ДКС] is null,[Дата проекта],[Дата исходного проекта]) [Дата исходного проекта]
,min([Дата передачи проекта]) as [Дата передачи проекта]
,count([Id ДФЛ]) as [Кол-во ТС в проекте]
,sum(ЧИИсходящие) as ЧИИсходящие
,1 as [Передача атрибуция]
into #atr
from
Report.Daily_ProjectMarketingCommunicationAttribution
where [Дата передачи проекта] between '2025-01-01' and getdate()
and ДатаПередачиДФЛ is not null
and iif([Исходный проект ДКС] is null,[Номер проекта],[Исходный проект ДКС]) <> 4313419   -- исключаем проект-выброс
group by 
iif([Исходный проект ДКС] is null,[Номер проекта],[Исходный проект ДКС]) 
,iif([Исходный проект ДКС] is null,[Дата проекта],[Дата исходного проекта]) 

--and [Номер проекта]=3623453
--and iif([Исходный проект ДКС] is null,[Номер проекта],[Исходный проект ДКС])=3623453



--drop table if exists #final;
select
	ti.[Номер задачи]
	,ti.[Номер проекта]
	,ti.[Дата создания задачи]
	,ti.[Дата завершения задачи]
	,ti.МК
	,ti.Канал
	,ti.[Класс закрывающего статуса]
	,ti.[Возвращен в КЦ]
	,ti.[Была передача по всем]
	,ti.[ТС передано по всем]
	,ti.[ЧИ по всем]
	,ti.[Площадка]
	,ЧИИсходящие
	,iif([номер проекта] is null,0,1) Был_прямой_проект
	,iif([Класс закрывающего статуса] = 'Лизинг. Не удалось дозвониться',0,1) Завершена_с_дозвоном
	,1 as odin 
	,[Передача атрибуция]
	,[Дата исходного проекта]
	,[Дата передачи проекта]
	,[Кол-во ТС в проекте]
--into #final
from 
	report.dcc_ba_tasks_info ti
	join WarehousePG.voipclient_leasing_task lt
		on ti.[Номер задачи]=lt.id
		and ti.[Дата завершения задачи] between '2025-01-01' and getdate()
		and ti.[Класс закрывающего статуса] <> 'Лизинг. Не удалось дозвониться'
		and lt.payload_type!='partners'
		and ti.Канал = 'Исходящие'
		and (ti.[Номер проекта] is null or ti.[Номер проекта] <> 4313419)   -- исключаем проект-выброс, задачи без проекта остаются
	left join #atr atr on atr.[Номер проекта с учетом передач по перезаведенным]=ti.[Номер проекта]
