select
     li.id                              as "id"          -- номер интеракции
    ,li.task                            as "task"        -- номер задачи
    ,li.status                          as "status"
    ,li.started                         as "started"
    ,li.ended                           as "ended"
    ,li.project_id                      as "project_id"
    ,li.comment                         as "comment"
    ,round(length(li.comment) / 5.0, 2) as "Words"       -- символы / 5 = "слова" для WPM
from
    voipclient.leasing_interaction li
    join voipclient.leasing_task     lt on lt.id = li.task
    join voipclient.leasing_campaign lc on lc.id = lt.campaign
where
        lc.type = 1                                        -- исходящий канал
    and li.ended >= now() - interval '12 months'           -- ended за последние 12 мес
    and li.comment is not null
    and btrim(li.comment) <> ''
    and length(li.comment) / 5.0 >= 10                     -- Words >= 10 (короткие не проговариваются)
    -- исключаем системные комментарии:
    and li.comment not ilike '%закрыт автодозвоном по НБТ%'                  -- НБТ-автозакрытие
    and not (li.comment ilike '%Следующий звонок%' and li.comment ilike '%Контакт%')  -- шаблон планирования следующего звонка
    and li.comment not ilike '%Задача деактивирована%'                       -- любая деактивация задачи
    and li.comment not ilike '%Правила работы по проекту ДКС%'               -- памятка по правилам работы
    and li.comment not ilike '%Комментарий к предмету согласования%'         -- шаблон согласования
    and not (li.comment ilike '%предметы лизинга%'
         and li.comment ilike '%выручка%'
         and li.comment ilike '%причина%')                                   -- шаблон с предметами лизинга/выручкой/причиной
    and li.comment not ilike '%получено согласование от%'                    -- шаблон согласования (получено ... от)
    and li.comment not ilike '%согласование получено от%'                    -- шаблон согласования (получено ... от, др. порядок)
    and li.comment not ilike '%Согласовано:%'                                -- отметка согласования
    and li.comment not ilike '%Согласовано :%'                               -- отметка согласования (пробел перед двоеточием)
    and li.comment not ilike '%Проект согласовал%'                           -- отметка согласования (в т.ч. "согласовала")
    and li.comment not ilike '%Заведение проекта согласовала%'               -- отметка согласования заведения
    and li.comment not ilike '%Предмет согласования%'                        -- шаблон согласования (предмет)
    and li.comment not ilike '%Причина проекта без встречи%'                 -- отметка причины (без встречи)
    and li.comment not ilike '%Заведение проекта согласовал%'                -- отметка согласования заведения (в т.ч. "согласовала")
    and not (li.comment ilike '%Контактное лицо%' and li.comment ilike '%встреч%')  -- шаблон с контактным лицом и встречей
    and li.comment not ilike '%http%'                                        -- ссылки (http и https)
    and li.comment not ilike '%Контактное лицо:%'                            -- шаблон с контактным лицом
    and li.comment not ilike '%Клиент:%'                                     -- шаблон с клиентом
    and li.comment not ilike '%согласовала%'                                 -- отметка согласования (форма "согласовала")
    and li.comment not ilike '%Клиент :%'                                    -- шаблон с клиентом (пробел перед двоеточием)
    and li.comment not ilike '%СОГЛАСОВАНО%'                                 -- отметка согласования (любой регистр = %согласовано%)
;
