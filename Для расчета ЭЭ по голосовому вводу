with base as (
    select
         li.id
        ,li.task
        ,li.status
        ,li.started
        ,li.ended
        ,li.project_id
        ,li.comment
    from
        voipclient.leasing_interaction li
        join voipclient.leasing_task     lt on lt.id = li.task
        join voipclient.leasing_campaign lc on lc.id = lt.campaign
    where
            lc.type = 1                                        -- исходящий канал
        and li.ended >= now() - interval '12 months'           -- ended за последние 12 мес
        and li.comment is not null
        and btrim(li.comment) <> ''
        and length(li.comment) / 5.0 >= 10                     -- Words >= 10 (по сырому тексту)
        -- исключаем системные комментарии:
        and li.comment not ilike '%закрыт автодозвоном по НБТ%'                  -- НБТ-автозакрытие
        and not (li.comment ilike '%Следующий звонок%' and li.comment ilike '%Контакт%')  -- планирование звонка
        and li.comment not ilike '%Задача деактивирована%'                       -- деактивация задачи
        and li.comment not ilike '%Правила работы по проекту ДКС%'               -- памятка
        -- согласование без предмета согласования:
        and not (btrim(li.comment) ilike 'Согласование получено%' and li.comment not ilike '%Комментарий к предмету согласования%')
        and not (btrim(li.comment) ilike 'Получено согласование%' and li.comment not ilike '%Комментарий к предмету согласования%')
)
select
     b.id                              as "id"          -- номер интеракции
    ,b.task                            as "task"        -- номер задачи
    ,b.status                          as "status"
    ,b.started                         as "started"
    ,b.ended                           as "ended"
    ,b.project_id                      as "project_id"
    ,b.comment                         as "comment"
    ,round(length(btrim(regexp_replace(b.comment, '\s+', ' ', 'g'))) / 5.0, 2) as "Words"   -- пробелы схлопнуты
    ,case
        when b.comment ilike '%Выручка%'
         and b.comment ilike '%Комментарий к предмету согласования:%'
        then round(
                length(
                    btrim(
                        regexp_replace(
                            coalesce(
                                substring(b.comment from '(?is)Комментарий к предмету согласования:(.*?)(?:Контактное лицо|Цель приобретения|Выручка компании за год)'),
                                substring(b.comment from '(?is)Комментарий к предмету согласования:(.*)$')
                            )
                        , '\s+', ' ', 'g')
                    )
                ) / 5.0
             , 2)
        -- не подошло под условие согласования → берём значение Words
        else round(length(btrim(regexp_replace(b.comment, '\s+', ' ', 'g'))) / 5.0, 2)
     end                               as "Wordsv2"      -- числовой, с точкой; иначе = Words
from base b
;
