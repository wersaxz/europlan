drop table if exists "tt_rep";
create temp table "tt_rep" as
select distinct 
		 coalesce(cta."GroupByOwnerId", -cta."CtaRepositoryId") as "GroupByOwnerId"
		,min(dl."ДатаПередачи") as "ДатаПередачи"
	from 	
		dwh."IC_ДоговорЛизинга" dl
	join 
		dwh."Cta_Counteragents" cta 
	on dl."BranchId" = cta."BranchId" 
	where 
		dl."ДатаПередачи" is not null
	group by 
		coalesce(cta."GroupByOwnerId", -cta."CtaRepositoryId")
;

--================================================================
--Собираем входящие звонки (Для чего блок ниже  не до конца понял, но у Морина есть)
--================================================================	
--Select * from "tt_dop_tasks"
--select * from voipclient.history_call
drop table if exists "tt_dop_tasks";
create temp table "tt_dop_tasks" as 
select
		c.id,
		c.contact,
		ic.answ_time,
		coalesce(coalesce(li.endtime, csi.ended_at), c.ended) as endtime,
		li.task,
		'Входящий звонок' as campaign_name
		,c."operator" 
	from
		voipclient.history_call c
	inner join 
		(select ica."call"
				,min(ica."created") as answ_time
		from voipclient.history_states_inbound_call ica 
		where ica."created" >= '2023-01-01'
		and ica."created" < '2024-01-01'
		and ica."skill" = 9
		and ica."state_skill" = 3
		group by ica."call"
		) ic
	on ic."call" = c.id
	left join 
		(select contact
				,min(ended_at) as ended_at
			from voipclient.client_service_interaction
			where ended_at is not null
			group by contact
		) csi
	on csi.contact = c.contact
	left join 
		(select contact
			   ,min(task) as task
			   ,min(ended) as endtime
		from voipclient.leasing_interaction 
		where ended is not null
		group by contact
	) li
	on li.contact = c.contact
	where c.contact is not null
;

--================================================================
--Собираем все итерации, джойним таблицу выше
--================================================================	 
--select * from "tt_interactions" where  campaign_name != 'Входящий звонок' and "Деактивирована" = 1
--select starttime - endtime from "tt_interactions" where starttime > endtime order by (starttime - endtime) desc
--select * from voipclient.leasing_campaign

drop table if exists "tt_interactions";
create temp table "tt_interactions" as 	
select
		 coalesce(i.task, c.id * -1) as task
		,coalesce(i."operator", c."operator") as "operator"
		,coalesce(t.created_at, c.answ_time) as created_at 
		,coalesce(t.campaign_name, c.campaign_name) as campaign_name
		,coalesce(t."Канал", 'Звонки') as "Канал"
		,coalesce(c.answ_time, i.started) as starttime
		,case when coalesce(i.ended, c.endtime) < coalesce(c.answ_time, i.started)
			  then coalesce(i.ended, c.endtime) + '3 hour'::interval 
			  else coalesce(i.ended, c.endtime) 
			  end as endtime
		,case 
			when (cs."class" != 9 and i."status" != 59) or (cs."class" IS NULL and i."status" is null) then 1
			else 0
		 end as "Дозвон"
		,case
			when i.status = 211 then 1
			else 0
		 end as "Наличие встречи"
		,t."Деактивирована"
	from
		voipclient.leasing_interaction i
	left join voipclient.configuration_status as cs
		on i.status = cs.id
	join (
		 select t.id
		 		,lc."name" as campaign_name
		 		,t.campaign
		 		,t.created_at 
		 		,case when lc."type" = 2 then 'Звонки' 
			  		  when lc."type" = 3 and t.payload_type != 'partners' then 'Заявки'
			          when lc."type" = 1 then 'Исходящий'
			          when t.payload_type = 'partners' then 'Поставщики'
			          end "Канал"
			    ,case when t.status = 233 then 1 else 0 end as "Деактивирована"
		 	from voipclient.leasing_task t
			left join voipclient.leasing_campaign lc 
			on t.campaign = lc.id 
			where t."status" in (122, 233)
			and t.created_at >= '2023-01-01'
			and t.created_at < '2024-01-01'
			and not exists(
						select 1
					    from voipclient.leasing_interaction
						where task = t.id
						and (
							ended is null
						or started is null
							)
						)
		) t
			on t.id = i.task
		full join
			"tt_dop_tasks" c
		on
			c.task = t.id
		and c.contact = i.contact
		where 
			i."operator" != 1
		or i."operator" is null
;	

--================================================================
--Определяем last_starttime
--================================================================
--select distinct "Должность" from "tt_interactions_2" where "Должность" is null campaign_name != 'Входящий звонок'
--select distinct "Должность", "Подразделение", "Грейд" from "tt_interactions_2"

drop table if exists "tt_interactions_2";
create temp table "tt_interactions_2" as 
select
		 ti.task
		,ti."operator"
		,op.login 
		,concat(op.last_name,' ',op.second_name,' ',op.first_name ) as "ФИО"
		,sotr."Должность" 
		,sotr."Подразделение"
		,case when sotr."Должность" ilike '%старший%' then 'СМПП'
			  when sotr."Должность" ilike '%младший%' then 'ММПП'
			  when sotr."Должность" ilike '%ведущий%' then 'ВМПП'
			  when sotr."Должность" ilike '%главный%' then 'ГМПП'
			  when sotr."Должность" in ('Эксперт', 'Менеджер', 'Специалист', 'Внештатный менеджер') then 'МПП'
			  else 'Прочие'
			  end "Грейд"
		,ti.created_at
		,ti."Деактивирована"
		,ti."Наличие встречи"
		,ti.campaign_name
		,ti."Канал"
		,ti.starttime
		,case
			when MAX(ti.starttime) over(partition by ti.task) = ti.starttime then 1
			else 0 
		 end as last_starttime
		,ti.endtime
		,ti."Дозвон"
	from
		"tt_interactions" ti 
	left join 
		 voipclient.configuration_operator AS op
	on ti."operator" = op.id
	left join 
		dwh."Сотрудники" sotr 
	on sotr."Логин" = op.login 
	and ti.starttime > sotr."DateFrom" 
	and ti.starttime < sotr."DateTo" 
	where 
		ti.starttime < ti.endtime
;
