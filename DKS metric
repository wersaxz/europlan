--================================================================
--Агрегированная статистика по месяцам
--================================================================
drop table if exists "s";
create temp table "s" as
select 
		ti."Канал"
		,cast(date_trunc('month', ti.created_at) as date) as "Месяц"
		,avg(case when ti."Дозвон" = 1 and ti."Был проект"= 0 then "Продолжительность задачи" else null end) as "Время на задачу без проекта с дозвоном"
		,avg(case when ti."Был проект"= 1 then "Продолжительность задачи" else null end) as "Время на задачу с проектом"
		,sum(case when ti."Деактивирована" = 1 then "Продолжительность задачи" else 0 end)*1.0 /
			sum("Продолжительность задачи") as "Время на деактивированные задачи"
		,sum(case when ti."Дозвон" = 0 then "Продолжительность задачи" else 0 end)*1.0 /
			sum("Продолжительность задачи") as "Время на задачи с недозвоном"
		,sum("Был проект")*1.0/(case when ti."Канал" = 'Исходящий' 
									 then count(case when ti."Дозвон" = 1 and ti."Деактивирована" = 0 then task else null end)
									 when ti."Канал" = 'Звонки'
									 then count(case when ti."Деактивирована" = 0 and task > 0 then task else null end)
									 else count(case when ti."Деактивирована" = 0 then task else null end) end) as "Конверсия из закрытой задачи в проект"
		,case 
			when sum("Был проект") = 0
			then 0
			else sum("Наличие встречи")*1.0/sum("Был проект") 
		end as "Доля проектов со встречей"
	from 
		"tt_itog" ti 
	group by 
		ti."Канал"
		,cast(date_trunc('month', ti.created_at) as date)
;

