		 it."Канал"
		 ,"Грейд"
		,cast(date_trunc('month', it.created_at) as date) as "Месяц"
		,it.project_id
		,it."Повторность"
		,ca."ProjectId" 
		,case when tt."ProjectId" is not null then 1 else 0 end as "Передан прямой проект ДКС"
		,case when tt2."ProjectId" is not null then 1 else 0 end as "Передан Перезаведенный проект ДКС"
	from 
		"tt_itog2" it 
	left join 
		dwh."ProjectMarketingCommunicationChannelAttribution" ca 
	on ca."OriginalProjectId" = it.project_id 
	left join 
		(select distinct dl."ProjectId" 
			from dwh."IC_ДоговорЛизинга" dl
			where dl."ДатаПередачи"  is not null
			and dl."ProjectId" is not null
				) tt 
	on tt."ProjectId" = it.project_id
	left join 
		(select distinct dl."ProjectId" 
			from dwh."IC_ДоговорЛизинга" dl
			where dl."ДатаПередачи"  is not null
			and dl."ProjectId" is not null
				) tt2 
	on tt2."ProjectId" = ca."ProjectId"
)
select distinct
		 a."Канал"
		 ,"Грейд"
		,a."Месяц"
		,a.project_id
		,a."Повторность"
		,max(case when a."Передан прямой проект ДКС" = 1 or a."Передан Перезаведенный проект ДКС" = 1 then 1 else 0 end) as "Передан"			
	from a
	where a.project_id is not null
	group by
		 a."Канал"
		 ,"Грейд"
		,a."Месяц"
		,a.project_id
		,a."Повторность"
;

--================================================================
--Считаем конверсию из проекта в передачу + месяц (исп отдельно, для демонстрации статистики)
--================================================================


--drop table if exists "tt_conv_for_statistic";
--create temp table "tt_conv_for_statistic" as
select 
		 a."Канал"
		 ,"Грейд"
		--,a."Месяц"
		,a."Повторность"
		,sum("Передан")*1.0/count(*) as "Конверсия из проекта в передачу"
	from 	
		"tt_conv2" a 
	group by 
		 a."Канал"
		 ,"Грейд"
		--,a."Месяц"
		,a."Повторность"
	order by 
		a."Канал"
		 ,"Грейд"
		--,a."Месяц"
		,a."Повторность"
;

--================================================================
--Считаем кол-во рабочих часов в каждом месяце
--================================================================

drop table if exists "tt_days";
create temp table "tt_days" as
select  distinct
		cast(date_trunc('month', "ДатаКалендарная") as date) as "Месяц",
		count( distinct "ДатаКалендарная") as work_days
	from
		ic."РегистрСведений_Календарь"
	where
			"ТипКалендаря" = '\x80987F73EB87F71044815D1BFFF84D4C'
		and "КоличествоЧасов" > 1
		and "ДатаКалендарная" between '2024-01-01' and '2025-01-01'
	group by date_trunc('month', "ДатаКалендарная");

