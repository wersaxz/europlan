--select distinct "Канал", campaign_name from  "tt_itog" where task<0

drop table if exists "tt_itog";
create temp table "tt_itog" as
with a as 
(select
			 t.task
			,t.created_at
			,coalesce(t."Деактивирована",0) as "Деактивирована"
			,max("Наличие встречи") as "Наличие встречи"
			,t.campaign_name
			,t."Канал"
			,case when tt.task is not null then 1 else 0 end "Был проект"
			,max(case when t.last_starttime = 1 and Дозвон = 1 
		    		  then 1 else 0
					  end) as "Дозвон"
			,sum(((DATE_PART('day', t.endtime::timestamp - t.starttime) * 24 + 
                DATE_PART('hour', t.endtime::timestamp - t.starttime)) * 60 +
                DATE_PART('minute', t.endtime::timestamp - t.starttime)) * 60 +
                DATE_PART('second', t.endtime::timestamp - t.starttime)) as "Продолжительность задачи"
           ,proj.project_id
           ,coalesce(cta."GroupByOwnerId", -cta."CtaRepositoryId") as "GroupByOwnerId"
	from
		"tt_interactions_2" t
	left join (
				select distinct task
				from voipclient.leasing_interaction i
					left join voipclient.configuration_status cs 
						on i.status = cs.id 
				where cs."class" = 34
				) tt
	on t.task = tt.task
	left join (
				select distinct task, project_id
				from voipclient.leasing_interaction i
				where project_id is not null
				) proj
	on t.task =proj.task
	left join 
		dwh."SAFO_Project" sp 
	on sp."Номер проекта" = proj.project_id
	left join 
		dwh."Cta_Counteragents" cta 
	on sp."BranchId" = cta."BranchId" 
	group by 
      	 t.task
		,t.campaign_name
		,t.created_at
		,t."Деактивирована"
		,t."Канал"
		,tt.task
		,proj.project_id
		,coalesce(cta."GroupByOwnerId", -cta."CtaRepositoryId")
) 
select 
		 a.task
		,a.created_at
		,a."Деактивирована"
		,a."Наличие встречи"
		,a.campaign_name
		,a."Канал"
		,a."Дозвон"
		,a."Продолжительность задачи"
		,a.project_id
		,a."GroupByOwnerId"
		,a."Был проект"
		,case when rp."ДатаПередачи" is null or rp."ДатаПередачи" > a.created_at then 'Новый' else 'Повторный' end as "Повторность"
	from  a 
	left join 
		"tt_rep" rp 
	on a."GroupByOwnerId" = rp."GroupByOwnerId"            
;

