with params as (
    select
         dateadd(month, -3, cast(getdate() as date))   as date_from
        ,dateadd(day, 1, cast(getdate() as date))      as date_to
        ,120                                           as min_talk_sec
        ,36                                            as purch_months
),
tasks as (
    select
         r.[Номер задачи]              as task_id
        ,r.[Дата завершения задачи]    as end_dt
        ,r.[МК]                        as mk
        ,r.[Закрывающий статус]        as status_name
        ,r.[Группа оператора]          as op_group
    from Report.dcc_ba_tasks_info r
    cross join params p
    where r.[Канал] = N'Исходящие'
      and r.[Закрывающий статус] in (N'Клиент думает', N'Неудобно разговаривать', N'Сброс звонка')
      and r.[Дата завершения задачи] >= p.date_from
      and r.[Дата завершения задачи] <  p.date_to
),
last_iter as (
    select task, operator, datediff(second, started, ended) as talk_sec
    from (
        select
             i.task
            ,i.operator
            ,i.started
            ,i.ended
            ,row_number() over (partition by i.task order by i.ended desc, i.id desc) as rn
        from WarehousePG.voipclient_leasing_interaction i
        where i.task in (select task_id from tasks)
          and i.ended is not null
    ) x
    where rn = 1
)
select
     t.task_id                                                      as [Номер задачи]
    ,t.end_dt                                                       as [Дата завершения задачи]
    ,t.mk                                                           as [МК]
    ,t.status_name                                                  as [Статус]
    ,cast(dateadd(second, li.talk_sec, 0) as time(0))               as [Длина разговора]
    ,concat(op.last_name, ' ', op.second_name, ' ', op.first_name)  as [ФИО оператора]
    ,t.op_group                                                     as [Группа оператора]
from tasks t
join last_iter li
    on li.task = t.task_id
join WarehousePG.voipclient_leasing_task lt
    on lt.id = t.task_id
left join WarehousePG.voipclient_configuration_operator op
    on op.id = li.operator
cross join params p
where li.talk_sec >= p.min_talk_sec
  and exists (
        select 1
        from WarehousePG.dwh_AllPurchases ap
        where ap.CtaRepositoryId = lt.cta_repository_id
          and ap.ActualRow = 1
          and ap.[ДатаПокупки] <  cast(t.end_dt as date)
          and ap.[ДатаПокупки] >= dateadd(month, -p.purch_months, cast(t.end_dt as date))
      )
order by t.end_dt desc;
