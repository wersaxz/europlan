-- Упущенная выгода: исходящий канал ДКС, закрывающие статусы, покупающие клиенты

-- 0. Параметры
drop table if exists tt_params;
create temp table tt_params as
select
     (current_date - interval '3 months')::date                                   as date_from
    ,(current_date + 1)::date                                                     as date_to
    ,array['Клиент думает', 'Неудобно разговаривать', 'Сброс звонка']::text[]     as statuses
;

-- 1. id нужных статусов (маленький справочник)
drop table if exists tt_status;
create temp table tt_status as
select cs.id, cs.name
from voipclient.configuration_status cs
cross join tt_params p
where cs.name = any(p.statuses)
;

-- 2. Итерации в периоде с нужным статусом, только исходящий канал
drop table if exists tt_cand;
create temp table tt_cand as
select
     i.task
    ,i.id          as interaction_id
    ,i.ended
    ,s.name        as status_name
    ,lc.name       as campaign_name
    ,t.cta_repository_id
from voipclient.leasing_interaction i
join tt_status s
    on s.id = i.status
join voipclient.leasing_task t
    on t.id = i.task
join voipclient.leasing_campaign lc
    on lc.id = t.campaign
   and lc.type = 1
cross join tt_params p
where i.ended >= p.date_from
  and i.ended <  p.date_to
;

-- 3. Оставляем только если это последняя итерация задачи и задача закрыта
drop table if exists tt_tasks;
create temp table tt_tasks as
select distinct on (c.task)
     c.task
    ,c.ended
    ,c.status_name
    ,c.campaign_name
    ,c.cta_repository_id
from tt_cand c
where not exists (
        select 1
        from voipclient.leasing_interaction i
        where i.task = c.task
          and (i.ended is null or i.ended > c.ended)
      )
order by c.task, c.ended desc, c.interaction_id desc
;

-- 4. Покупки только по клиентам из списка, окно 24 мес. до самой ранней даты завершения
drop table if exists tt_purch;
create temp table tt_purch as
select
     ap."CtaRepositoryId"   as cta_id
    ,ap."ДатаПокупки"       as purch_date
from dwh."AllPurchases" ap
where ap."ActualRow"::int = 1
  and ap."CtaRepositoryId" in (select distinct cta_repository_id from tt_tasks)
  and ap."ДатаПокупки" >= (select min(ended)::date - interval '24 months' from tt_tasks)
;

-- 5. Итог: ≥1 покупки за 12 мес. ИЛИ ≥4 покупок за 24 мес. до завершения задачи
select
     t.task            as "Номер задачи"
    ,t.ended           as "Дата завершения задачи"
    ,t.campaign_name   as "МК"
    ,t.status_name     as "Статус"
from tt_tasks t
join tt_purch pu
    on pu.cta_id = t.cta_repository_id
   and pu.purch_date <  t.ended::date
   and pu.purch_date >= (t.ended - interval '24 months')::date
group by t.task, t.ended, t.campaign_name, t.status_name
having count(*) filter (where pu.purch_date >= (t.ended - interval '12 months')::date) >= 1
    or count(*) >= 4
order by t.ended desc
;
